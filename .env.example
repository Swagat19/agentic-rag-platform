# API Configuration
APP_ENV=development
LOG_LEVEL=INFO
APP_HOST=0.0.0.0
APP_PORT=8058
API_URL=http://api:8058

# Streamlit Configuration
SERVER_PORT=8501
SERVER_HOST=0.0.0.0

# Postgres + pgvector
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=postgres
DB_PORT=5432
DB_NAME=vector_db

# ---------------------------------------------------------------------------
# LLM Provider Configuration
# ---------------------------------------------------------------------------
# All chat and embedding traffic goes through OpenAI-compatible APIs. Setting
# OPENAI_BASE_URL redirects those calls to any OpenAI-compatible endpoint
# (Ollama, LM Studio, vLLM, Groq, OpenRouter, ...) without changing code.
#
# --- Ollama (local, free) ---
#   OPENAI_BASE_URL=http://host.docker.internal:11434/v1
#   OPENAI_API_KEY=ollama          # any non-empty string works
#   LLM_CHOICE=qwen2.5:14b
#   EMBEDDING_MODEL=nomic-embed-text
#   NOTE: schema.sql is configured for vector(768), which matches
#   nomic-embed-text. If you switch to OpenAI text-embedding-3-small
#   (1536 dim) update sql/schema.sql and reinitialise the DB volume.
#
# --- OpenAI (paid, cloud) ---
#   OPENAI_BASE_URL=               # leave empty to use api.openai.com
#   OPENAI_API_KEY=sk-...
#   LLM_CHOICE=gpt-4o-mini
#   EMBEDDING_MODEL=text-embedding-3-small
#
# Defaults below assume Ollama. Edit to your provider of choice.
OPENAI_BASE_URL=http://host.docker.internal:11434/v1
OPENAI_API_KEY=ollama
LLM_CHOICE=qwen2.5:14b
EMBEDDING_MODEL=nomic-embed-text

# ---------------------------------------------------------------------------
# Ingestion Tuning
# ---------------------------------------------------------------------------
# EMBEDDING_BATCH_SIZE: how many chunks to send to the embedding endpoint per
# HTTP request. OpenAI tolerates ~1000 (LangChain's default), but Ollama's
# /v1/embeddings shim crashes its tokenizer subprocess on large batches; 16
# is a safe value for Ollama on a Mac. Bump this for OpenAI/cloud providers.
EMBEDDING_BATCH_SIZE=16

# Docling extractor toggles. include_images runs a Vision-Language Model
# (SmolVLM) per image; CPU-only it adds ~minutes per page for little
# retrieval signal on text-heavy reports. Flip to 1 if you have a GPU and
# want image descriptions in the index.
PDF_ENABLE_OCR=0
PDF_INCLUDE_IMAGES=0
PDF_INCLUDE_TABLES=1
